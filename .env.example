# ── Google OAuth & Gmail API ──────────────────────────────────────────────
# From console.cloud.google.com: create a project, enable the "Gmail API",
# then create an OAuth 2.0 Client ID (Web application) under
# APIs & Services > Credentials. Add the gmail.readonly scope under
# APIs & Services > OAuth consent screen > Scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client, e.g.
# http://localhost:4000/auth/google/callback in dev.
GOOGLE_REDIRECT_URI=

# ── Anthropic Claude API ───────────────────────────────────────────────────
# From console.anthropic.com > API Keys. Used with the Haiku model for
# task extraction.
ANTHROPIC_API_KEY=

# ── Supabase ────────────────────────────────────────────────────────────────
# From your Supabase project's Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend ──────────────────────────────────────────────────────────────────
# From resend.com dashboard > API Keys. Also verify a sending domain there,
# and set RESEND_FROM_EMAIL to an address on that domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Razorpay ────────────────────────────────────────────────────────────────
# From dashboard.razorpay.com (use Test Mode keys during development).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings > Webhooks > create a webhook pointing at
# {BACKEND_URL}/api/webhooks/razorpay, then copy its secret here.
RAZORPAY_WEBHOOK_SECRET=
# A Razorpay Plan ID (dashboard.razorpay.com > Subscriptions > Plans) used
# for the paid-tier subscription.
RAZORPAY_PLAN_ID=

# ── Token encryption ─────────────────────────────────────────────────────────
# Used to AES-256-GCM encrypt the Gmail refresh token before it's stored in
# Supabase. Generate one locally with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── App config ──────────────────────────────────────────────────────────────
# Public URL of the deployed frontend (Vercel URL in prod).
APP_URL=http://localhost:3000
# Public URL of this backend (used to build the Google redirect + webhook
# URLs when they aren't set explicitly). Railway URL in prod.
BACKEND_URL=http://localhost:4000
# Random long string used to sign the session cookie. Generate with:
# openssl rand -hex 32
SESSION_SECRET=
# Port the Express server listens on locally.
PORT=4000

# ── Frontend build config ───────────────────────────────────────────────────
# Used by the Vite frontend (frontend/.env, or set in Vercel project settings)
# to know where the backend API lives. Not read by the backend itself.
VITE_BACKEND_URL=http://localhost:4000
